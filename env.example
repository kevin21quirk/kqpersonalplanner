# ============================================================
# KQ Personal Planner — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# Database (Neon.tech PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&channel_binding=require"

# OpenAI API — https://platform.openai.com
OPENAI_API_KEY="sk-..."

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Google OAuth — https://console.cloud.google.com
# Enable: Google Calendar API, Google Meet API
# Redirect URI: http://localhost:3000/api/integrations/google/callback
GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."

# App owner (used to identify the personal planner owner)
OWNER_EMAIL="your@email.com"
OWNER_NAME="Your Name"
